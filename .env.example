# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Required, exactly "demo" or "supabase". The server refuses to start if it is missing or misspelt.
# demo = file based store, no Supabase needed (local testing only). supabase = real backend.
APP_MODE=demo
# A production build (npm run build + npm start) refuses to run in demo mode unless this is true.
# Only for trying the production build on your own machine. Never set it on a public server.
ALLOW_DEMO_IN_PRODUCTION=false
# How many reverse proxies you control sit in front of the app. Signup and login limits use the client address,
# and only the entry your own proxy wrote can be trusted. Vercel, nginx, Caddy or a load balancer: 1.
# Cloudflare in front of nginx: 2. 0 = browsers reach the app directly (your own machine); every visitor then
# shares one signup and login allowance. Required for production builds (npm start).
TRUSTED_PROXY_HOPS=0
# Random 32+ character string, required in both modes. Signs demo sessions and the "recognised browser" cookie
# that protects logins from lockout. Generate: openssl rand -hex 32
SESSION_SECRET=
# 32 byte hex key used to encrypt Google tokens at rest. Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# ---------- Supabase (needed when APP_MODE=supabase) ----------
# Public (sent to the browser by design): used only for sign up, log in and sessions (Supabase Auth).
NEXT_PUBLIC_SUPABASE_URL=
# The project's publishable key (sb_publishable_...). The legacy anon key also works, under either this name or
# NEXT_PUBLIC_SUPABASE_ANON_KEY (the publishable key wins if both are set).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. All app data is read and written from the server through this PostgreSQL connection.
# Use the Supabase "Transaction pooler" connection string (port 6543), for example:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Easiest: run `npm run db:setup` once. It asks for this string (hidden), tests it, creates the tables and saves it
# to .env.local. TLS needs no setup: Supabase's certificate authority is built in and certificates are always verified.
# Optional, only for a database that is not on Supabase: DATABASE_CA_CERT (PEM, newlines written as \n).
# Connections each server instance keeps (default 3). Keep it small on Vercel; the pooler shares connections.
DATABASE_POOL_MAX=3
# Not used by the app (data goes through DATABASE_URL). Leave it unset on Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Email (Resend), optional ----------
# Without both, no email is sent and the app says so (contact form, report emails and notices are off).
# Server only. Resend > API Keys (sending access is enough). Starts with re_.
RESEND_API_KEY=
# The sender, on a domain verified in Resend (never gmail.com): GMBmirror <notifications@yourdomain.com>
EMAIL_FROM=
# Optional. Where replies go; default gmbmirror@gmail.com.
EMAIL_REPLY_TO=

# ---------- Google Business Profile ----------
# Optional. Google Search Console's HTML-tag verification code (only the content value), to verify the domain
# for Google OAuth. Adds <meta name="google-site-verification"> to every page.
GOOGLE_SITE_VERIFICATION=
# OAuth client from Google Cloud Console (type: Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# Switches live Business Profile calls on (reviews, replies, posts, insights). Set to true once Google has approved
# the project (quota 300 QPM) and the OAuth client exists. While false, owners can connect but see labelled samples.
GBP_API_APPROVED=false
# Never set GOOGLE_API_BASE_URL: it exists only for the isolated test servers, and the app ignores it unless it is a
# loopback http:// address.

# ---------- Google Places API (New) ----------
# Optional. Server-side only, never sent to the browser. Enables Place ID search, the live profile audit,
# competitor comparison and the local rank grid. Enable "Places API (New)" for this key in Google Cloud.
GOOGLE_PLACES_API_KEY=

# ---------- AI providers ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Leave empty to use https://api.anthropic.com
ANTHROPIC_BASE_URL=
# Optional. Add these to run visibility checks on ChatGPT and Gemini directly.
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# ---------- Background jobs (scheduled posts, review automation, Google refreshes, monthly reports) ----------
# A scheduler calls POST /api/jobs/run with "Authorization: Bearer <CRON_SECRET>" (at least 16 characters).
# Generate: openssl rand -hex 24. Without it the endpoint is off.
CRON_SECRET=
# Vercel Cron calls GET /api/jobs/run with this header automatically when CRON_SECRET is set on the project.
# inprocess: run jobs on a timer inside the server (one long-running server, for example npm start or a VM).
# off: only the endpoint above (Vercel, serverless, several instances). Empty: on for npm start in demo mode only.
JOBS_RUNNER=
# Seconds between in-process runs (minimum 15).
JOBS_INTERVAL_SECONDS=60

# ---------- AI usage ----------
# Claude calls allowed per user per calendar month, all features together.
AI_MONTHLY_CALL_LIMIT=600
# Set to true only to also ask OpenAI and Gemini in AI visibility checks (needs their keys above). Default: Claude only.
AI_EXTRA_PROVIDERS=false
# Business Profile requests this server sends per minute at most (Google's approved quota is 300). Leave at 250.
GBP_QPM_GUARD=250

# ---------- Rank grid cost control ----------
# Grid points each user may scan per 24 hours, all locations together (a 3x3 scan uses 9, a 5x5 scan 25).
# Each scan makes 1 + points Google Places requests. Default 75. Minimum 9.
GRID_POINTS_PER_DAY=75

